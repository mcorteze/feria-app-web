rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCollaborator(listData) {
      return isSignedIn() &&
        listData.collaboratorUids.hasAny([request.auth.uid]);
    }

    // joinListAsBuyer se agrega a SÍ MISMO a una lista de la que todavía no
    // es colaborador (por eso isCollaborator(resource.data), evaluado sobre
    // el estado ANTES del update, siempre da false acá — es la misma
    // dependencia circular que ya se resolvió para "get"). Se permite este
    // caso puntual verificando que collaboratorUids después del cambio sea
    // exactamente collaboratorUids antes + el propio uid (nadie puede
    // agregar a un tercero, ni tocar ningún otro campo del documento en esta
    // vía).
    function isSelfJoining() {
      let before = resource.data;
      let after = request.resource.data;
      return isSignedIn() &&
        !before.collaboratorUids.hasAny([request.auth.uid]) &&
        after.collaboratorUids == before.collaboratorUids.concat([request.auth.uid]) &&
        after.diff(before).affectedKeys().hasOnly(['collaborators', 'collaboratorUids']);
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;

      match /frequentCollaborators/{collaboratorUid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /lists/{listId} {
      allow create: if isSignedIn() &&
        request.resource.data.collaboratorUids.hasAny([request.auth.uid]);
      // get (documento individual) se permite a cualquier autenticado: es lo
      // que joinListAsBuyer necesita leer ANTES de convertirse en colaborador
      // para validar que el código de invitación existe. list (query de
      // colección) sigue restringido a colaboradores vía isCollaborator, así
      // que nadie puede enumerar listas ajenas, solo leer una si ya conoce su
      // ID exacto (el código de invitación).
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isCollaborator(resource.data);
      allow update: if isSignedIn() && (isCollaborator(resource.data) || isSelfJoining());
      allow delete: if isSignedIn() && isCollaborator(resource.data);

      match /items/{itemId} {
        function parentList() {
          return get(/databases/$(database)/documents/lists/$(listId)).data;
        }

        allow read, write: if isSignedIn() && isCollaborator(parentList());
      }
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /stalls/{stallId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      // Los puestos son un catálogo compartido de facto (no por lista): el
      // modo Organizar del comprador necesita reordenar/eliminar puestos
      // creados por otros usuarios, por eso se relaja de owner-only a
      // cualquier autenticado (mismo nivel que ya tenía "read").
      allow update, delete: if isSignedIn();
    }
  }
}
